/**
 * Definition for singly-linked list.
 * struct ListNode {
 *     int val;
 *     ListNode *next;
 *     ListNode() : val(0), next(nullptr) {}
 *     ListNode(int x) : val(x), next(nullptr) {}
 *     ListNode(int x, ListNode *next) : val(x), next(next) {}
 * };
 */
class Solution {
public:
    ListNode* insertionSortList(ListNode* head) {
        ListNode* dummy = new ListNode(-5050, head);
        ListNode* p = head;
        ListNode* c = head -> next;
        while(c != nullptr){
            ListNode* n = c -> next;
            if(c -> val < p -> val){
                ListNode* temp = dummy;
                while(temp -> next -> val < c -> val)
                    temp = temp -> next;
                p -> next = c ->　next;
                c -> next = temp -> next;
                temp -> next = c;
            }else{
                p = c;
            }
            c = n;
        }
        return dummy -> next;
    }
};
