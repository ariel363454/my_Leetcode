class Solution {
public:
    bool isPalindrome(string s) {
        for(int i = 0;i < s.length();i++){
            if('A' <= s[i] && s[i] <= 'Z'){
                s[i] += 32;
            }else if(('a' > s[i] || s[i] > 'z') && ('0' > s[i] || s[i] > '9')){
                s.erase(i, 1);
                i--;
            }
        }
        if(s.length() < 2)
            return true;
        for(int i = 0;i < s.length() / 2;i++){
            if(s[i] != s[s.length() - i - 1])
                return false;
        }
        return true;
    }
};
