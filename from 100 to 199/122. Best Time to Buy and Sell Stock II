class Solution {
public:
    int maxProfit(vector<int>& prices) {
        int buy = prices[0], sell = 0;
        int pft = 0;
        for(int i = 1;i < prices.size();i++){
            if(prices[i] < buy){
                buy = prices[i];
                sell = 0;
            }else{
                sell = prices[i];
            }
            pft = max(sell - buy, pft);
        }
        //cout << buy << sell;
        return max(pft, 0);
    }
};
