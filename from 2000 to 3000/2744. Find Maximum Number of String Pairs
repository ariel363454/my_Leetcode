class Solution {
public:
    int maximumNumberOfStringPairs(vector<string>& words) {
        set<string> reverse_words;
        int ans = 0;
        for(int i = 0;i < words.size();i++){
            if(reverse_words.count(words[i])){
                ans ++;
                reverse_words.erase(words[i]);
            }else{
                string temp = "";
                temp += words[i].back();
                temp += words[i].front();
                reverse_words.insert(temp);
            }
        }

        return ans;
    }
};
