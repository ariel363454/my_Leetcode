class Solution {
public:
    vector<vector<string>> groupAnagrams(vector<string>& strs) {
        unordered_map<string, int> mp;
        vector<vector<string>> ans;
        int t = 0;
        for(int i = 0;i < strs.size();i++){
            string key = strs[i];
            sort(key.begin(), key.end());
            if(mp.count(key) == 0){
                mp[key] = t;
                t++;
                ans.push_back({});
            }
            ans[mp[key]].push_back(strs[i]);
        }
        return ans;
    }
};
