class Solution {
public:
    string simplifyPath(string path) {
        string ans = "";
        stack<string> s;
        for(int i = 0;i < path.length();i++){
            if (path[i] == '/') continue;
            string t = "";
            while(i < path.length() && path[i] != '/'){
                t += path[i];
                i++;
            }
            if (t == "..") {
                if (!s.empty()) s.pop();
            } else if (t != "." && t != "") {
                s.push(t);
            }
        }
        while(!s.empty()){
            ans = "/" + s.top() + ans;
            s.pop();
        }
        if(ans == "")
            ans = "/";
        return ans;
    }
};
